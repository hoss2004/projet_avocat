POSTGRES_PASSWORD=replace-with-a-long-local-password
APP_DB_PASSWORD=replace-with-a-different-long-password
DATABASE_URL=postgresql+psycopg://legal_app:replace-with-a-different-long-password@postgres:5432/legal
MIGRATION_DATABASE_URL=postgresql+psycopg://legal:replace-with-a-long-local-password@postgres:5432/legal
API_KEY=replace-with-at-least-32-random-characters
TENANT_ID=00000000-0000-0000-0000-000000000001
STORAGE_PATH=/data/storage
MAX_UPLOAD_SIZE=26214400
MAX_PDF_PAGES=1500

# IA locale : lancer Ollama puis télécharger les deux modèles.
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b
OLLAMA_URL=http://host.docker.internal:11434
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
MIN_RETRIEVAL_SCORE=0.75
MODEL_TIMEOUT=180
# Option service compatible, inactive par défaut :
LLM_BASE_URL=http://host.docker.internal:8080/v1
LLM_API_KEY=
ALLOW_REMOTE_LLM=false
